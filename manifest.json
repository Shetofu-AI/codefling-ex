{
  "manifest_version": 3,
  "name": "CodeflingEx",
  "version": "1.4.0",
  "description": "Insert custom HTML into Codefling file descriptions, bypassing the CKEditor content filter.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["https://codefling.com/*"],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
